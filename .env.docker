# Required: Change this to a strong random string
JWT_SECRET=change-me-in-production-use-strong-random-string

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS — frontend is served by Express on port 3000)
FRONTEND_URL=http://localhost:3000

# Database (json or postgres)
DB_TYPE=json
DB_FILE=./data/db.json

# Build limits
MAX_CONCURRENT_BUILDS=3
BUILD_TIMEOUT=300000
POLLING_INTERVAL=60

# Logging
LOG_LEVEL=info
MAX_LOG_SIZE=10
MAX_LOG_FILES=5
LOG_DISK_THRESHOLD=90
LOG_RETENTION_DAYS=7

# Registration
ALLOW_REGISTRATION=true

# Retention
RETENTION_DAYS=30
DEFAULT_TIMEOUT=3600

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
